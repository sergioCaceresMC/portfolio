---
import '../styles/global.css';
import '@fontsource-variable/open-sans/wght.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body class=" text-gray-950">
		
		<div class="absolute bottom-0 left-0 right-0 top-0 bg-[linear-gradient(to_right,#aaaaaa2e_1px,transparent_1px),linear-gradient(to_bottom,#aaaaaa2e_1px,transparent_1px)] bg-[size:34px_34px] [mask-image:radial-gradient(ellipse_80%_50%_at_50%_0%,#000_70%,transparent_150%)]">
			<slot />
		</div>
	</body>
</html>

<style>
	html,
	body {
		font-family: 'Open Sans Variable', sans-serif;
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
