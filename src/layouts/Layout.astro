---
import "../styles/global.css";
import "@fontsource-variable/open-sans/wght.css";
import logo from "../assets/favicon.svg";
---

<!doctype html>
<html lang="en" class="scroll-pt-20">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <link rel="icon" href={logo.src} />
    <meta name="generator" content={Astro.generator} />
    <title>Sergio Miranda</title>
  </head>
  <body class="text-gray-950">
    <div class="absolute inset-0">
      <!-- Fondo con grid + blur -->
      <div
        class="absolute inset-0
				bg-[linear-gradient(to_right,#aaaaaa2e_1px,transparent_1px),linear-gradient(to_bottom,#aaaaaa2e_1px,transparent_1px)]
				bg-size-[34px_34px]
				mask-[radial-gradient(ellipse_80%_50%_at_50%_0%,#000_70%,transparent_150%)]"
      >
      </div>

      <!-- Contenido -->
      <div class="relative z-10">
        <slot />
      </div>
    </div>
  </body>
</html>

<style>
  html,
  body {
    font-family: "Open Sans Variable", sans-serif;
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
