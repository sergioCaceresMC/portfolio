---
import { Icon } from 'astro-icon/components';
---

<nav class="z-20 mx-auto flex justify-center bg-white px-5 py-10 border-b-1 border-b-gray-200">
    <img src="" alt="" />

    <div id="menu" class="font-light mx-auto flex gap-15 justify-between">
        <a href="/" class="transition-all duration-300 hover:text-blue-600 hover:scale-105 hover:translate-y-[-2px]">Home</a>
        <a href="/technologies" class="transition-all duration-300 hover:text-blue-600 hover:scale-105 hover:translate-y-[-2px]">Technologies</a>
