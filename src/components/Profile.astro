---
import profile from "../assets/image_cv.jpg";
---

<div
  class="flex flex-col-reverse sm:flex-row gap-10 md:gap-2 justify-center sm:justify-between md:max-w-6xl mx-auto mt-10 px-10"
>
  <!-- Description -->
  <div class="mx-auto sm:mx-0 text-left my-auto">
    <h1 class="text-2xl md:text-3xl lg:text-4xl">
      HI, <br />
      <span class="text-4xl md:text-5xl lg:text-8xl font-bold">I'M SERGIO</span>
      <br />
      BIOMEDICAL ENGINEERING.
    </h1>
    <button
      class="mx-auto md:mx-0 mt-5 px-3 py-2 rounded-2xl bg-gray-900 text-white
        transition-all duration-300 hover:scale-105 hover:-translate-y-0.5
        cursor-pointer"
      >Download CV</button
    >
  </div>

  <!-- Photo -->
  <div class="text-center">
    <img
      src={profile.src}
      alt="Logo"
      class="mx-auto my-2 sm:my-10 rounded-full size-40 sm:size-50 md:size-65 lg:size-80"
    />
  </div>
</div>
