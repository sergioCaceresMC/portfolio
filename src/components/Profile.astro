---
import profile from '../assets/image_cv.jpg'
---

<div class="flex flex-col-reverse lg:flex-row justify-center lg:justify-between md:max-w-6xl mx-auto mt-10 px-10">
    <!-- Description -->
    <div class="text-center md:text-left my-auto px-10 lg:px-0">
        <h1 class=" text-4xl">
            HI, <br> 
            <span class="text-8xl font-bold">I'M SERGIO</span> <br> 
            BIOMEDICAL ENGINEERING
        </h1>
        <button class="mt-5 px-3 py-2 rounded-2xl bg-gray-900 text-white
        transition-all duration-300 hover:scale-105 hover:-translate-y-0.5
        cursor-pointer
        ">Download CV</button>
    </div>

    <!-- Photo -->
    <div class="text-center">
        <img src={profile.src} alt="Logo" class="mx-auto my-10 rounded-full size-80" />
    </div>
</div>