---
import profile from "../assets/image_cv.jpg";
import cv from "../assets/cv/CV_Sergio_Miranda.pdf";
---

<div
  id="home"
  class="flex flex-col-reverse sm:flex-row gap-3 md:gap-2 justify-center sm:justify-between md:max-w-6xl mx-auto mt-25 px-10"
>
  <!-- Description -->
  <div class="mx-auto sm:mx-0 text-center sm:text-left my-auto">
    <h1 class="text-2xl md:text-3xl lg:text-4xl">
      HI, <br />
      <span class="text-4xl md:text-5xl lg:text-8xl font-bold">I'M SERGIO</span>
      <br />
      BIOMEDICAL ENGINEERING.
    </h1>
    <div class="flex items-center mt-5 justify-center sm:justify-normal">
      <a
        href={cv}
        download
        class="inline-block md:mx-0 px-3 py-2 rounded-2xl bg-gray-900 text-white transition-all duration-300 hover:scale-105 hover:-translate-y-0.5"
      >
        Download CV
      </a>
